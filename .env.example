# Required for Generative AI
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Required for Supabase deployment
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_anon_or_publishable_key

# Optional local fallback if Supabase is not configured
LOCAL_DB_PATH=rescuelens.db

# Optional: password for the Command Center (leave empty for no password)
COMMAND_CENTER_PASSWORD=
